DATABASE_URL=postgres://user:pass@localhost:5432/gfl2
NODE_ENV=development

# --- Auth / profiles API (src/server) ---
# Discord OAuth app credentials (https://discord.com/developers/applications)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Secret used to HMAC-sign session tokens and OAuth state — any long random
# string. REQUIRED in prod; an insecure dev default is used if unset.
SESSION_SECRET=
# Optional: override the OAuth redirect URI. Default is the request origin +
# /auth/discord/callback.
# OAUTH_REDIRECT_URI=http://localhost:4173/auth/discord/callback
# Comma-separated origins allowed for CORS and OAuth return_to.
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# Server port (default 4173 — the vite dev proxy targets this).
# PORT=4173

# --- Discord bot (src/bot) ---
# Discord bot (required for the bot to start; optional for the website)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register commands in a single guild instantly during development
DISCORD_GUILD_ID=

# Optional: canonical URL for links shared by the bot (defaults to localhost)
SITE_URL=http://localhost:5173

# --- Analytics (Umami) ---
# Self-hosted analytics. Omit both to disable. No cookie banner needed.
# UMAMI_URL=https://cloud.umami.is
# UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
