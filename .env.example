DATABASE_URL=postgres://user:pass@localhost:5432/gfl2
NODE_ENV=development

# Discord bot (required for the bot to start; optional for the website)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register commands in a single guild instantly during development
DISCORD_GUILD_ID=

# Optional: canonical URL for links shared by the bot (defaults to localhost)
SITE_URL=http://localhost:5173
