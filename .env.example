DATABASE_URL=postgres://user:pass@localhost:5432/gfl2
NODE_ENV=development

# --- Auth / profiles API (src/server) ---
# Discord OAuth app credentials (https://discord.com/developers/applications)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Secret used to HMAC-sign session tokens and OAuth state — any long random
# string. REQUIRED in prod; an insecure dev default is used if unset.
SESSION_SECRET=
# Optional: override the OAuth redirect URI. Default is the request origin +
# /auth/discord/callback.
# OAUTH_REDIRECT_URI=http://localhost:4173/auth/discord/callback
# Comma-separated origins allowed for CORS and OAuth return_to.
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# Server port (default 4173 — the vite dev proxy targets this).
# PORT=4173

# --- Discord bot (src/bot) ---
# Discord bot (required for the bot to start; optional for the website)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register commands in a single guild instantly during development
DISCORD_GUILD_ID=

# Optional: canonical URL for links shared by the bot (defaults to localhost)
SITE_URL=http://localhost:5173

# --- Platoon roster (/sheet, /username, /roster) ---
# Google service account key JSON (the whole file, as one line) — used to
# create and write the platoon roster sheets. Enable the Sheets + Drive APIs
# on the project. Without it, /sheet and sheet syncing are disabled.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Drive folder the sheets are created in. REQUIRED with a plain service
# account: service accounts have zero Drive storage (Apr 2025), so the sheet
# must live in a folder a human owns and has shared with the service account
# as editor. Use the folder ID from its URL (drive.google.com/drive/folders/<ID>).
# GOOGLE_DRIVE_FOLDER_ID=
# Roster OCR service (ocr-service/ deployed on Railway). Without it /roster
# is disabled.
# ROSTER_OCR_URL=https://your-ocr-service.up.railway.app
# Optional shared secret; set the same value as OCR_API_KEY on the service.
# ROSTER_OCR_KEY=

# --- Analytics (Umami) ---
# Self-hosted analytics. Omit both to disable. No cookie banner needed.
# UMAMI_URL=https://cloud.umami.is
# UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
