{
  "name": "gfl2-team-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Discord bot + team-building website for Girls' Frontline 2: Exilium",
  "scripts": {
    "build": "tsc",
    "build:server": "tsc && cp -r src/infographics/assets dist-server/infographics/assets",
    "build:web": "npm run build:server && npm run vite:build",
    "build:bot": "npm run build:server",
    "start:web": "node dist-server/server/index.js",
    "start:bot": "node dist-server/bot/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "sync": "tsx src/bin/sync.ts",
    "icons": "tsx src/bin/fetch-icons.ts",
    "derive": "tsx src/bin/derive.ts",
    "derive:report": "tsx src/bin/derive.ts --report",
    "analyze:mentions": "tsx src/bin/analyze-mentions.ts",
    "render:og": "tsx src/bin/render-og.ts",
    "sitemap": "tsx src/bin/build-sitemap.ts",
    "precompress": "tsx src/bin/precompress.ts",
    "test": "vitest run",
    "smoke:ui": "npm run vite:build && node scripts/ui-verify.mjs",
    "dev": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "vite:build": "npm run sitemap && vite build && npm run precompress",
    "preview": "vite preview",
    "serve": "npm run vite:build && tsx src/server/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev:bot": "tsx watch src/bot/index.ts",
    "bot:start": "tsx src/bot/index.ts",
    "bot:deploy-commands": "tsx src/bot/deploy-commands.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "import:recs": "tsx src/bin/import-recommendations.ts",
    "seed:datamine": "tsx src/bin/seed-from-datamine.ts",
    "purge:dandegate": "tsx src/bin/purge-dandegate.ts",
    "migrate:profiles": "tsx src/bin/migrate-profiles.ts",
    "prepare": "husky",
    "indexnow": "tsx src/bin/indexnow.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@napi-rs/canvas": "^1.0.6",
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.1",
    "hono": "^4.13.2",
    "html-to-image": "^1.11.13",
    "node-cron": "^4.6.0",
    "pg": "^8.13.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "drizzle-kit": "^0.30.2",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
