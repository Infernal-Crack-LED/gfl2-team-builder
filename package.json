{
  "name": "gfl2-team-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Discord bot + team-building website for Girls' Frontline 2: Exilium",
  "scripts": {
    "build": "tsc",
    "build:server": "tsc",
    "build:web": "npm run build:server && npm run vite:build",
    "build:bot": "npm run build:server",
    "start:web": "node dist-server/server/index.js",
    "start:bot": "node dist-server/bot/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "sync": "tsx src/bin/sync.ts",
    "derive": "tsx src/bin/derive.ts",
    "derive:report": "tsx src/bin/derive.ts --report",
    "analyze:mentions": "tsx src/bin/analyze-mentions.ts",
    "test": "vitest run",
    "dev": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "vite:build": "vite build",
    "preview": "vite preview",
    "serve": "npm run vite:build && tsx src/server/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.1",
    "hono": "^4.13.2",
    "pg": "^8.13.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "drizzle-kit": "^0.30.2",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
