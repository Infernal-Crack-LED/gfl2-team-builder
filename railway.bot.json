{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "npm run build:bot"
  },
  "deploy": {
    "preDeployCommand": "npm run db:migrate && npm run bot:deploy-commands",
    "startCommand": "node dist-server/bot/index.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
